# Aucune valeur réelle ici. Copier en .env sur l'hébergement Python.
ENGINE_ENV=development
# Clé partagée entre le serveur Lovable et ce service (générer >= 32 caractères aléatoires)
ENGINE_SHARED_KEY=
# URL du backend d'authentification (même que VITE_SUPABASE_URL côté Lovable)
SUPABASE_URL=
# Clé publishable (publique) utilisée pour vérifier le jeton utilisateur via /auth/v1/user
SUPABASE_PUBLISHABLE_KEY=
# Origines autorisées (séparées par des virgules) — en pratique seul le serveur Lovable appelle l'API
CORS_ORIGINS=https://energie-renouvelable.lovable.app
MAX_BODY_BYTES=3000000
